{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "showcase-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/showcase/ShowcaseWebPart.js",
          "manifest": "./src/webparts/showcase/ShowcaseWebPart.manifest.json"
        }
      ]
    },
    "developer-toolkit-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/developerToolkit/DeveloperToolkitWebPart.js",
          "manifest": "./src/webparts/developerToolkit/DeveloperToolkitWebPart.manifest.json"
        }
      ]
    }
  },
  "externals": {},
  "localizedResources": {
    "ShowcaseWebPartStrings": "lib/webparts/showcase/loc/{locale}.js",
    "DeveloperToolkitWebPartStrings": "lib/webparts/developerToolkit/loc/{locale}.js",
    "ControlStrings": "node_modules/@pnp/spfx-controls-react/lib/loc/{locale}.js"
  }
}